{
  "manifest_version": 3,
  "name": "FormBench 淘宝清单助手",
  "description": "在自己的浏览器中核对 FormBench 采购清单，并在官方商品页逐项处理。",
  "version": "1.1.0",
  "action": {"default_title":"选好规格后点击，带回 FormBench"},
  "minimum_chrome_version": "106",
  "permissions": ["storage"],
  "host_permissions": ["https://item.taobao.com/*", "https://detail.tmall.com/*", "https://login.taobao.com/*", "https://login.tmall.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches":["https://lizuoqiu.github.io/formbench-studio/*","http://127.0.0.1/*","http://localhost/*"],"js":["bridge.js"],"all_frames":false,"run_at":"document_start"},
    {"matches":["https://item.taobao.com/item.htm*","https://detail.tmall.com/item.htm*"],"js":["product.js"],"all_frames":false,"run_at":"document_idle"}
  ]
}
